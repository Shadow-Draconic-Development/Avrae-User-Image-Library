<drac2>


def search_list(query: str, item_list: list[str]) -> list[str]|None:
    """
    Searches for item in list.

    Args:
        query (str): The query being made
        item_list (list): List of items

    Return:
        list[str]|None: If it finds at least one match, it returns the item(s) in a list, otherwise it returns None
    """

    # Finds at least 1 match
    if len(item_results := [item for item in item_list if query.lower() in item.lower()]) > 0:
        return item_results

    # If it finds no matches
    else:
        return None


def multiple_match_determine(search_result: list[str], input_value: str) -> str|bool:
    """
    Determines if there is an exact match in search results
    
    Args:
        search_result (list[str]): List of search results
        input_value (str): Input value to match

    Returns:
        str|bool: The exact match if found, otherwise False
    """

    for match in search_result:
        if match.lower() == input_value.lower():
            return match

    return False


def main(input_list: list[str]) -> str:
    """
    Main program function

    Args:
        input_list (list[str]): List of user inputs

    Return:
        str: Image URL    
    """

    # Setup
    prefix = ctx.prefix
    footer = f"{prefix}portrait [image name] | 7/23/25 | ShadowsStride"

    # If at least one input is provided
    if len(input_list) > 0:

        # If the UVAR exists, load dictionary
        if (uvar_test := get_uvar("imageLibrary")):
            uvar_dict = load_json(uvar_test)

            # If there is at least one match
            if (search_result := search_list(input_list[0], uvar_dict.keys())):

                # If there is exactly one match
                if len(search_result) == 1:
                    return f"{prefix}portrait update {search_result[0]}"

                # If there is more than one match
                else:

                    # If there is an exact match
                    if (search_result2 := multiple_match_determine(search_result, input_list[0])):
                        return f"{prefix}portrait update {search_result2}"

                    # If there is not an exact match
                    else:
                        search_result.insert(0, "**Multiple Matches Found:**")
                        joined_str = "\n".join(search_result)

                        return f"{prefix}embed -title 'You Have Been Sneak Attacked by an Error' -f '{joined_str}' -color '#CF142B' -footer '{footer}' -thumb 'https://raw.githubusercontent.com/Shadow-Draconic-Development/Avrae-User-Image-Library/main/Data/error.png'"

            # If there are no matches
            else:
                return f"{prefix}embed -title 'You Have Been Sneak Attacked by an Error' -f 'Image not found (`{input_list[0]}`)' -color '#CF142B' -footer '{footer}' -thumb 'https://raw.githubusercontent.com/Shadow-Draconic-Development/Avrae-User-Image-Library/main/Data/error.png'"

        # If the UVAR does not exist
        else:
            return f"{prefix}embed -title 'You Have Been Sneak Attacked by an Error' -f 'Your image library has not been created yet' -color '#CF142B' -footer '{footer}' -thumb 'https://raw.githubusercontent.com/Shadow-Draconic-Development/Avrae-User-Image-Library/main/Data/error.png'"

    # If there are no inputs
    else:
        return f"{prefix}embed -title 'You Have Been Sneak Attacked by an Error' -f 'Expected image name' -color '#CF142B' -footer '{footer}' -thumb 'https://raw.githubusercontent.com/Shadow-Draconic-Development/Avrae-User-Image-Library/main/Data/error.png'"


# Main program function
output = main(&ARGS&)


</drac2>
